{
  "comments": { "lineComment": "#" },
  "brackets": [["[", "]"], ["(", ")"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["comment"] }
  ],
  "surroundingPairs": [["[", "]"], ["(", ")"], ["{", "}"], ["\"", "\""], ["*", "*"]],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_.-]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*\\?",
    "decreaseIndentPattern": "^\\s*(==|@label)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*-\\s+.*$",
      "action": { "indent": "none", "appendText": "- " }
    }
  ]
}
